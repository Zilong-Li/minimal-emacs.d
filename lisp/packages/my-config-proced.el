;;; my-config-proced.el --- Personal proced configuration -*- no-byte-compile: t; lexical-binding: t; -*-

(use-package proced
  :ensure nil
  :defer t
  :custom
  (proced-enable-color-flag t)
  (proced-tree-flag t)
  (proced-auto-update-flag 'visible)
  (proced-auto-update-interval 1)
  (proced-descent t)
  (proced-filter 'user) ;; We can change interactively with `s'
  :config
  (add-hook 'proced-mode-hook
            (lambda ()
              (proced-toggle-auto-update 1))))

(provide 'my-config-proced)
;;; my-config-proced.el ends here
